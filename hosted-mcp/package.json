{
  "name": "verdigraph-mcp-hosted",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Public, OAuth-authenticated, billable MCP server for Verdigraph compute-routing services. Hosted on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
