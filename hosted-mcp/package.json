    "test:parity": "vitest run tests/parity.test.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "agents": "^0.12.4",
    "hono": "^4.6.0",
    "stripe": "^17.0.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.95.0"
  }
}
