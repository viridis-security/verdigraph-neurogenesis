{
  "schema_version": 1,
  "standard": "VOS-OPEN-PAYLOAD-1",
  "state": "PUBLISHED",
  "private_source": "viridis-security/verdigraph-service",
  "software_license": "MIT",
  "documentation_license": "MIT",
  "include": [
    ".dockerignore",
    ".github/**",
    ".gitignore",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "Dockerfile",
    "LICENSE",
    "README.md",
    "VISION.md",
    "docs/**",
    "examples/**",
    "papers/**",
    "pyproject.toml",
    "quickstart.sh",
    "scripts/**",
    "server.json",
    "tests/**",
    "verdigraph/**",
    "verdigraph_mcp/**",
    "verdigraph_state/**",
    "OPEN_SOURCE_MANIFEST.json",
    "SECURITY.md",
    "TRADEMARKS.md",
    ".gitleaks.toml"
  ],
  "exclude": [
    "**/.env",
    "**/.env.*",
    "!**/.env.example",
    "**/*.pem",
    "**/*.key",
    "**/*keypair*.json",
    "**/service-account*.json",
    "*BUSINESS*",
    "*HANDOFF*",
    "*DEPLOY*",
    "*REVENUE*"
  ],
  "protected_or_unreleased": [
    "production trust-root signing and revocation",
    "certification mark authorization",
    "settlement, billing and metering",
    "customer and partner systems and data",
    "deployment credentials and infrastructure"
  ],
  "external_mutation": false
}
